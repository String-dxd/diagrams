{
  "name": "diagrams",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run sync:tools",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:watch": "jest --watch",
    "sync:tools": "node scripts/sync-julienne-tools.js --write",
    "sync:check": "node scripts/sync-julienne-tools.js --check",
    "security:audit": "npm audit --audit-level=high",
    "verify": "npm run sync:tools && npm run sync:check && npm run test:ci && npm run security:audit && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "@next/third-parties": "15.5.22",
    "next": "15.5.22",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^14",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@tootallnate/once": "2.0.1",
    "brace-expansion": "1.1.18",
    "form-data": "4.0.6",
    "js-yaml": "3.15.1",
    "postcss": "8.5.25",
    "sharp": "0.35.0",
    "ws": "8.21.1"
  }
}
